#!/usr/bin/env bash
# Lance Hello (ou transmet l'option à l'instance déjà ouverte : hello --toggle, hello --show emoji…).
# gtk4-layer-shell doit être chargée avant libwayland-client : on la précharge.
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
for lib in /usr/lib/libgtk4-layer-shell.so /usr/lib64/libgtk4-layer-shell.so \
           /usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so /usr/lib/aarch64-linux-gnu/libgtk4-layer-shell.so \
           /usr/lib/libgtk4-layer-shell.so.0 /usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0; do
    if [[ -e "$lib" ]]; then
        export LD_PRELOAD="$lib${LD_PRELOAD:+:$LD_PRELOAD}"
        break
    fi
done
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m hello "$@"
